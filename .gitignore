# Build directories
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Coverage
coverage/
lcov.info

# ============================================
# PLATFORM SPECIFIQUE
# ============================================

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/.generated/
**/.symlinks/

# Fichiers générés par flutter_launcher_icons (iOS)
**/ios/Runner/Assets.xcassets/AppIcon.appiconset/*.png
# Garder uniquement le Contents.json

# Fichiers générés par flutter_native_splash (iOS - si réactivé)
**/ios/Runner/Assets.xcassets/LaunchImage.imageset/*.png
**/ios/Runner/Assets.xcassets/LaunchBackground.imageset/*.png

# Android
**/android/.gradle/
**/android/captures/
**/android/gradle.properties
**/android/local.properties
**/android/gradlew
**/android/gradlew.bat
**/android/gradle-wrapper.jar
**/android/.idea/
**/android/*.iml
**/android/app/google-services.json

# Fichiers générés par flutter_launcher_icons
**/android/app/src/main/res/mipmap-*/ic_launcher.png
**/android/app/src/main/res/mipmap-*/ic_launcher_foreground.png
**/android/app/src/main/res/mipmap-*/ic_launcher_round.png
**/android/app/src/main/res/drawable/ic_launcher_background.xml
**/android/app/src/main/res/values/ic_launcher_background.xml

# Fichiers générés par flutter_native_splash (si réactivé)
**/android/app/src/main/res/drawable/launch_background.xml
**/android/app/src/main/res/drawable-*/launch_background.xml
**/android/app/src/main/res/drawable/splash.png
**/android/app/src/main/res/drawable-*/splash.png
**/android/app/src/main/res/drawable/android12splash.png
**/android/app/src/main/res/drawable-*/android12splash.png

