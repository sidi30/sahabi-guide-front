#######################################################
# 🔐 CONFIGURATION SAHABI GUIDE - PRÊT À L'EMPLOI
#######################################################
# Ce fichier est pré-configuré avec les bonnes valeurs
# Copiez-le en .env : Copy-Item env.template .env
# Puis lancez : docker-compose up -d
#######################################################

#############################
# 🗄️ POSTGRESQL
#############################
POSTGRES_DB=sahabi_db
POSTGRES_USER=sahabi
POSTGRES_PASSWORD=sahabi
POSTGRES_PORT=5432

#############################
# 🔐 KEYCLOAK (OBLIGATOIRE)
#############################
# ⚠️ Keycloak est OBLIGATOIRE pour l'authentification
# Ne JAMAIS désactiver en production !
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=localhost
# Pour production avec domaine :
# KEYCLOAK_HOSTNAME=auth.votre-domaine.com

#############################
# 🔧 BACKEND (Spring Boot)
#############################
SPRING_PROFILE=dev
BACKEND_PORT=8084

# OAuth2/OIDC (utilise le service Docker Keycloak)
# 🔐 OBLIGATOIRE : Ne jamais désactiver la sécurité !
OIDC_ISSUER_URI=http://keycloak:8080/realms/sahabi
APP_SECURITY_ENABLED=true  # ⚠️ TOUJOURS true en production

# JWT (pour application mobile)
JWT_SECRET=mySecretKeyForSahabiGuideApplicationThatIsVerySecureAndLongEnough
JWT_EXPIRATION=7776000
JWT_ISSUER=sahabi-guide
JWT_KEY_LENGTH=256
JWT_ALGORITHM=HS256

# CORS (autorise frontend et keycloak)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8084

# Twilio (SMS OTP) - Désactivé en dev
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_RETRY_MAX_ATTEMPTS=3
TWILIO_RETRY_BACKOFF_DELAY=2000

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# Rate Limiting (permissif pour dev)
RATE_LIMIT_MAX_LOGIN=20
RATE_LIMIT_MAX_OTP_REQUESTS=10
RATE_LIMIT_MAX_OTP_VERIFICATIONS=20

# Auth Cleanup
AUTH_CLEANUP_ENABLED=false

#############################
# 🎨 FRONTEND (React Dashboard)
#############################
FRONTEND_PORT=3000

# API Configuration (pointe vers le backend Docker)
VITE_API_BASE_URL=http://localhost:8084
VITE_API_BASE_PATH=/api/v1

# Keycloak Configuration (pointe vers Keycloak Docker)
# 🔐 OBLIGATOIRE : Keycloak est maintenant requis par défaut
# Laisser vide ou mettre 'true' pour activer (défaut: activé)
# Mettre 'false' uniquement en développement local si nécessaire
VITE_ENABLE_KEYCLOAK=true  # ⚠️ TOUJOURS true en production
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sahabi
VITE_KEYCLOAK_CLIENT_ID=sahabi-dashboard

#############################
# 🌐 CADDY (Reverse Proxy + SSL)
#############################
DOMAIN=sahabi.local
ACME_EMAIL=admin@sahabi.local

#############################
# 🔒 TAILSCALE (Accès Internet - Optionnel)
#############################
# ✅ Votre clé Tailscale (déjà configurée)
TAILSCALE_AUTHKEY=tskey-auth-kH5XSEoevj11CNTRL-mJ5ZMXHRzNB7Qz4ypgiDPBpcdSdQY7jk9
TAILSCALE_HOSTNAME=sahabi-guide
TAILSCALE_EXTRA_ARGS=--advertise-tags=tag:sahabi

#############################
# 📊 PGADMIN (Administration DB - Optionnel)
#############################
PGADMIN_EMAIL=admin@sahabi.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

#######################################################
# ✅ CONFIGURATION TERMINÉE
#######################################################
# Ce fichier est prêt à l'emploi !
# 
# Pour démarrer les services de base :
# 1. Copy-Item env.template .env
# 2. docker-compose up -d
#
# Pour démarrer avec Caddy et Tailscale (production) :
# docker-compose --profile production up -d
#
# Pour démarrer avec PgAdmin (outils de dev) :
# docker-compose --profile tools up -d
#
# Services disponibles en local :
# - PostgreSQL : postgres:5432 (inter-conteneurs)
# - Keycloak : keycloak:8080 (inter-conteneurs)
# - Backend : backend:8084 (inter-conteneurs)
# - Frontend : localhost:3000 (depuis votre navigateur)
# - API : localhost:8084 (depuis votre navigateur)
# - Keycloak Admin : localhost:8080 (depuis votre navigateur)
# - PgAdmin : localhost:5050 (depuis votre navigateur, avec --profile tools)
#
# Aucune autre configuration n'est nécessaire !
#######################################################

