default_platform(:ios)

platform :ios do
  desc "Build the Flutter iOS app and upload it to TestFlight"
  lane :beta do
    # Clé API App Store Connect (depuis les secrets GitHub, .p8 encodé en base64)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )

    # Archive + signature automatique : Apple crée/renouvelle cert + profil via la clé API
    # (-allowProvisioningUpdates), pas besoin de match ni de profil manuel.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      api_key: api_key,
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: "4SRJRX4N45"
      },
      output_directory: "build",
      output_name: "sahabi_guide.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
