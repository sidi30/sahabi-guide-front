<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Sahabi Guide</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>sahabi_guide</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- ============================================ -->
		<!-- PERMISSIONS - LOCALISATION                   -->
		<!-- ============================================ -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Sahabi Guide utilise votre position, uniquement lorsque l'application est ouverte, pour vous guider vers les lieux saints, permettre la fonction SOS et le regroupement avec votre caravane, et calculer les heures de prière. Aucune collecte en arrière-plan.</string>
		<!-- Exigee par Apple ITMS-90683 : un SDK de localisation reference l'API
		     "Always" meme si l'app n'utilise la position QUE lorsqu'elle est ouverte
		     (pas de mode "location" dans UIBackgroundModes). Description alignee. -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Sahabi Guide utilise votre position uniquement lorsque l'application est ouverte, pour vous guider vers les lieux saints, permettre la fonction SOS et le regroupement avec votre caravane, et calculer les heures de prière. Aucune collecte en arrière-plan.</string>
		<!-- ============================================ -->
		<!-- PERMISSIONS - NOTIFICATIONS                  -->
		<!-- ============================================ -->
		<key>NSUserNotificationsUsageDescription</key>
		<string>Sahabi Guide envoie des notifications pour les rappels de prière, les alertes d'urgence et les messages de votre groupe.</string>
		<!-- ============================================ -->
		<!-- PERMISSIONS - MICROPHONE (optionnel)         -->
		<!-- ============================================ -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Sahabi Guide peut utiliser votre microphone pour les appels d'urgence et l'assistance vocale.</string>
		<!-- Reconnaissance vocale (SDK speech_to_text -> SFSpeechRecognizer). Exigee par
		     Apple ITMS-90683 meme si la voix n'est pas utilisee directement. -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Sahabi Guide utilise la reconnaissance vocale pour la recherche et l'assistance par la voix.</string>
		<!-- ============================================ -->
		<!-- BACKGROUND MODES                             -->
		<!-- ============================================ -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<!-- ============================================ -->
		<!-- CONFIGURATION SUPPLÉMENTAIRE                 -->
		<!-- ============================================ -->
		<!-- Support du mode sombre -->
		<key>UIUserInterfaceStyle</key>
		<string>Automatic</string>
		<!-- Langues supportées -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>fr</string>
			<string>en</string>
			<string>ar</string>
			<string>ha</string>
		</array>
		<!-- Sécurité réseau -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<!-- Bloquer les connexions HTTP non sécurisées -->
			<key>NSAllowsArbitraryLoads</key>
			<false/>
			<!-- Local networking disabled for production security -->
			<key>NSAllowsLocalNetworking</key>
			<false/>
		</dict>
		<!-- Support des fichiers iCloud (optionnel) -->
		<key>LSSupportsOpeningDocumentsInPlace</key>
		<true/>
		<key>UIFileSharingEnabled</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
