<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuration pour PRODUCTION : HTTPS uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Certificats système Android uniquement -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production domain with certificate pinning placeholder -->
    <domain-config>
        <domain includeSubdomains="true">sahabiguide.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Emulator only: allow cleartext for 10.0.2.2 (debug builds) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- LAN local : autorise le HTTP pour les tests de terrain via WiFi
         (PC hote du backend sahabi-guide-api sur le meme reseau).
         Couvre 192.168.0.0/16 et 10.0.0.0/8 les plus frequents. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.100</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
    </domain-config>
</network-security-config>

