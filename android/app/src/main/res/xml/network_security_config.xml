<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuration pour PRODUCTION : HTTPS uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Certificats système Android uniquement -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production domain with certificate pinning placeholder -->
    <domain-config>
        <domain includeSubdomains="true">sahabiguide.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Emulator only: allow cleartext for 10.0.2.2 (debug builds) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

