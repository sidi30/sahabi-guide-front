<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuration pour PRODUCTION : HTTPS uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Certificats système Android -->
            <certificates src="system" />
            <!-- Certificats utilisateur (pour debug avec proxy) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Configuration pour DÉVELOPPEMENT : Autoriser localhost -->
    <!-- Cette section sera automatiquement désactivée en release build -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>

